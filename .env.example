# ============================================================
# Nomiqa — نموذج متغيرات البيئة
# انسخ هذا الملف إلى .env ولا ترفع .env إلى المستودع أبداً.
# في Staging وProduction تُقرأ هذه القيم من Secrets Manager.
# ============================================================

NODE_ENV=development

# ---------- قاعدة البيانات ----------
DATABASE_URL=postgresql://nomiqa:nomiqa_dev_password@localhost:5432/nomiqa?schema=public

# ---------- Redis (Cache + BullMQ) ----------
REDIS_URL=redis://localhost:6379

# ---------- Auth0 (ADR-010) ----------
# استخدم Tenant منفصلاً لكل بيئة: dev / staging / prod
AUTH0_DOMAIN=your-tenant.eu.auth0.com
AUTH0_ISSUER_BASE_URL=https://your-tenant.eu.auth0.com

# معرّف الـAPI المسجّل في Auth0 — يتحقق منه NestJS كـaudience
AUTH0_AUDIENCE=https://api.nomiqa.local

# تطبيق Regular Web Application الخاص بـNext.js
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
# مفتاح تشفير جلسة Next.js — ولّده بـ: openssl rand -hex 32
AUTH0_SECRET=

# تطبيق Machine-to-Machine للوصول إلى Management API
# (مطلوب لحذف المستخدم من Auth0 عند حذف الحساب)
AUTH0_M2M_CLIENT_ID=
AUTH0_M2M_CLIENT_SECRET=

# ---------- عناوين التطبيقات ----------
APP_BASE_URL=http://localhost:3000
API_PORT=3001
NEXT_PUBLIC_API_URL=http://localhost:3001

# ---------- Object Storage (MinIO محلياً / S3 في الإنتاج) ----------
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=nomiqa-dev
S3_ACCESS_KEY_ID=nomiqa
S3_SECRET_ACCESS_KEY=nomiqa_dev_password
S3_FORCE_PATH_STYLE=true

# دلو الوسائط المنشورة — قراءة عامة، ولا يحتوي إلا نسخ صور البطاقات
# المنشورة. لا تضع فيه أي ملف مؤسسي: القراءة العامة خاصية للدلو كله.
S3_PUBLIC_BUCKET=nomiqa-dev-public
# أصل الـCDN في الإنتاج. محلياً يُشتق من S3_ENDPOINT تلقائياً.
S3_PUBLIC_BASE_URL=

# ---------- البريد ----------
# محلياً: Mailpit على 1025 — لا يغادر أي بريد الجهاز.
# راجع الرسائل على http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Nomiqa <no-reply@nomiqa.local>

# ---------- المراقبة ----------
# اتركه فارغاً محلياً: بلا DSN لا يُفعَّل Sentry، فلا تُرسل أخطاء
# التطوير إلى مشروع مشترك.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
OTEL_EXPORTER_OTLP_ENDPOINT=
LOG_LEVEL=debug

# ---------- حدود المعدل ----------
# الحد الافتراضي 300 طلب/دقيقة لكل مستخدم أو عنوان.
# المسارات الحساسة لها حدود أضيق معرّفة في الشيفرة بـ@RateLimit.

# ---------- التحليلات ----------
# سرّ تجزئة الزائر. اتركه فارغاً محلياً — يُستخدم سرّ تطوير معروف.
#
# **مطلوب في الإنتاج**: بدونه تصير التجزئة قابلة لإعادة الحساب من
# عنوان مخمَّن، فيتحول مقياس «الزائر الفريد» إلى وسيلة تحقّق من أن
# عنواناً بعينه زار بطاقة بعينها — وهو ما صُمم هذا الحقل لمنعه.
# ولّده بـ32 بايتاً عشوائياً على الأقل، وثبّته: تغييره يجعل كل زوار
# اليوم يبدون جدداً.
ANALYTICS_VISITOR_SECRET=
