# ============================================================
# Nomiqa — نموذج متغيرات البيئة
# انسخ هذا الملف إلى .env ولا ترفع .env إلى المستودع أبداً.
# في Staging وProduction تُقرأ هذه القيم من Secrets Manager.
# ============================================================

NODE_ENV=development

# ---------- قاعدة البيانات ----------
# محلياً: Postgres في docker-compose. في الإنتاج: Supabase.
#
# على Supabase استخدم رابطي الاتصال من لوحة التحكم (Connect):
#   DATABASE_URL = مجمّع المعاملات (Transaction pooler، المنفذ 6543)
#                  مع ?pgbouncer=true — لوقت تشغيل التطبيق.
#   DIRECT_URL   = مجمّع الجلسات (Session pooler، المنفذ 5432) — لهجرات
#                  Prisma حصراً (مجمّع المعاملات لا يدعم أقفال DDL).
# راجع docs/deploy/README.md للقيم الدقيقة.
DATABASE_URL=postgresql://nomiqa:nomiqa_dev_password@localhost:5432/nomiqa?schema=public
# محلياً: نفس قيمة DATABASE_URL (الاتصال المباشر يدعم الهجرات).
DIRECT_URL=postgresql://nomiqa:nomiqa_dev_password@localhost:5432/nomiqa?schema=public

# ---------- Redis (Cache + BullMQ) ----------
REDIS_URL=redis://localhost:6379

# ---------- Auth0 (ADR-010) ----------
# استخدم Tenant منفصلاً لكل بيئة: dev / staging / prod
AUTH0_DOMAIN=your-tenant.eu.auth0.com
AUTH0_ISSUER_BASE_URL=https://your-tenant.eu.auth0.com

# معرّف الـAPI المسجّل في Auth0 — يتحقق منه NestJS كـaudience
AUTH0_AUDIENCE=https://api.nomiqa.local

# تطبيق Regular Web Application الخاص بـNext.js
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
# مفتاح تشفير جلسة Next.js — ولّده بـ: openssl rand -hex 32
AUTH0_SECRET=

# تطبيق Machine-to-Machine للوصول إلى Management API
# (مطلوب لحذف المستخدم من Auth0 عند حذف الحساب)
AUTH0_M2M_CLIENT_ID=
AUTH0_M2M_CLIENT_SECRET=

# ---------- عناوين التطبيقات ----------
APP_BASE_URL=http://localhost:3000
API_PORT=3001
NEXT_PUBLIC_API_URL=http://localhost:3001

# ---------- Object Storage (MinIO محلياً / S3 في الإنتاج) ----------
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=nomiqa-dev
S3_ACCESS_KEY_ID=nomiqa
S3_SECRET_ACCESS_KEY=nomiqa_dev_password
S3_FORCE_PATH_STYLE=true

# دلو الوسائط المنشورة — قراءة عامة، ولا يحتوي إلا نسخ صور البطاقات
# المنشورة. لا تضع فيه أي ملف مؤسسي: القراءة العامة خاصية للدلو كله.
S3_PUBLIC_BUCKET=nomiqa-dev-public
# أصل الـCDN في الإنتاج. محلياً يُشتق من S3_ENDPOINT تلقائياً.
S3_PUBLIC_BASE_URL=

# ---------- البريد ----------
# محلياً: Mailpit على 1025 — لا يغادر أي بريد الجهاز.
# راجع الرسائل على http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Nomiqa <no-reply@nomiqa.local>

# ---------- المراقبة ----------
# اتركه فارغاً محلياً: بلا DSN لا يُفعَّل Sentry، فلا تُرسل أخطاء
# التطوير إلى مشروع مشترك.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
OTEL_EXPORTER_OTLP_ENDPOINT=
LOG_LEVEL=debug

# ---------- حدود المعدل ----------
# الحد الافتراضي 300 طلب/دقيقة لكل مستخدم أو عنوان.
# المسارات الحساسة لها حدود أضيق معرّفة في الشيفرة بـ@RateLimit.

# ---------- التحليلات ----------
# سرّ تجزئة الزائر. اتركه فارغاً محلياً — يُستخدم سرّ تطوير معروف.
#
# **مطلوب في الإنتاج**: بدونه تصير التجزئة قابلة لإعادة الحساب من
# عنوان مخمَّن، فيتحول مقياس «الزائر الفريد» إلى وسيلة تحقّق من أن
# عنواناً بعينه زار بطاقة بعينها — وهو ما صُمم هذا الحقل لمنعه.
# ولّده بـ32 بايتاً عشوائياً على الأقل، وثبّته: تغييره يجعل كل زوار
# اليوم يبدون جدداً.
ANALYTICS_VISITOR_SECRET=

# ---------- الفوترة وبوابة الدفع (المرحلة 4) ----------
# القرار موثّق في docs/adr/ADR-014-payment-gateway.md
#
# ثواني تفصل بيئة الاختبار عن الإنتاج بمضيفين مختلفين. القيم أدناه
# لبيئة UAT، وتُبدَّل بمضيف الإنتاج عند الإطلاق التجاري. العنوان إعداد
# لا ثابت في الشيفرة عمداً: تصحيحه يجب ألا يتطلب إصداراً جديداً.
THAWANI_BASE_URL=https://uatcheckout.thawani.om/api/v1
THAWANI_CHECKOUT_URL=https://uatcheckout.thawani.om/pay

# المفتاح السرّي يُرسل في ترويسة thawani-api-key ولا يغادر الخادم أبداً.
THAWANI_SECRET_KEY=
# المفتاح المعلَن يظهر في رابط صفحة الدفع — ليس سرّاً.
THAWANI_PUBLISHABLE_KEY=

# ضريبة القيمة المضافة بالنقاط الأساسية. عُمان 5% = 500.
# القيمة تُنسخ على كل فاتورة عند إصدارها، فتغييرها لا يمس الصادر.
BILLING_VAT_RATE_BPS=500

# ---------- المحافظ الرقمية (المرحلة 5) ----------
# القرار موثّق في docs/adr/ADR-015-wallet-passes.md
#
# كل ما يلي اختياري: بلا ضبطه يبقى زر المحفظة معطّلاً برسالة واضحة
# بدل أن يفشل بعد الضغط. الجاهزية تُقرأ من /wallets/availability.

# --- Apple Wallet ---
# معرّف نوع البطاقة ومعرّف الفريق من Apple Developer.
APPLE_WALLET_PASS_TYPE_ID=
APPLE_WALLET_TEAM_ID=
# شهادة Pass Type ID ومفتاحها الخاص وشهادة Apple الوسيطة (WWDR).
# تُقبل خاماً بأسطر PEM أو مرمَّزة Base64 — أنظمة الأسرار تختلف في نقل
# النصوص متعددة الأسطر، ورفض إحدى الصيغتين يظهر كخطأ توقيع غامض.
APPLE_WALLET_CERT_PEM=
APPLE_WALLET_KEY_PEM=
APPLE_WALLET_KEY_PASSPHRASE=
APPLE_WALLET_WWDR_PEM=

# --- Google Wallet ---
# معرّف المُصدِر من Google Pay & Wallet Console.
GOOGLE_WALLET_ISSUER_ID=
GOOGLE_WALLET_SERVICE_ACCOUNT_EMAIL=
# مفتاح حساب الخدمة بصيغة PKCS#8. لا يغادر الخادم: الرابط الموقّع وحده
# هو ما يصل المتصفح.
GOOGLE_WALLET_PRIVATE_KEY=
# لاحقة الصنف الذي تنتمي إليه البطاقات. يُنشأ مرة واحدة من لوحة Google،
# وصنف مفقود يجعل كل رابط يفشل **بعد** فتحه — أي عند المستخدم لا عندنا.
GOOGLE_WALLET_CLASS_SUFFIX=nomiqa_card

# ---------- المسح والتعرّف الضوئي (المرحلة 6) ----------
# القرار موثّق في docs/adr/ADR-016-ocr-provider.md
#
# الافتراضي `none`: المسح يعمل بلا محرك — تظهر الحقول فارغة يملؤها
# المندوب. ميزة تتعطّل بلا مفتاح خارجي تجعل التثبيت المحلي عاجزاً عن
# اختبار المسار كله.
#
# القيم: none | google_vision
OCR_PROVIDER=none

# مطلوب حين يكون OCR_PROVIDER=google_vision. الخدمة تصير مُعالِجاً
# فرعياً لبيانات أطراف ثالثة، فأضفها إلى سجل المعالجة قبل تفعيلها.
GOOGLE_VISION_API_KEY=

# ---------- التكاملات (المرحلة 6) ----------
# لا مفاتيح هنا: مفاتيح الـAPI وأسرار التوقيع ورموز الـCRM كلها **صفوف
# في قاعدة البيانات تخص كل مؤسسة**، لا إعداد منصة. مفتاح واحد في متغير
# بيئة كان يعني سرّاً مشتركاً بين كل العملاء.
#
# APP_BASE_URL أعلاه هو ما يُبنى عليه رابط تقرير الفعالية في البريد.
