{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    // CommonJS مقصود: تطبيق NestJS يعمل بـCJS ويستهلك هذه الحزم بـrequire،
    // بينما الـWorker (ESM) وWeb يستطيعان استيراد CJS دون مشكلة.
    // العكس غير صحيح — CJS لا يستطيع require حزمة ESM.
    "module": "CommonJS",
    "moduleResolution": "Node",
    "verbatimModuleSyntax": false
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.test.ts"]
}
