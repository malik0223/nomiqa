// ============================================================
// Nomiqa — مخطط قاعدة البيانات
// المرجع: وثيقة المعمارية §6.3 و§6.4
//
// قواعد حاكمة:
//  1. كل جدول يخص المؤسسة يحمل organizationId + فهرس مركّب يبدأ به.
//  2. المعرّفات العامة UUID ولا تُكشف أرقام تسلسلية في الروابط.
//  3. كل التواريخ TIMESTAMPTZ ومخزّنة بـUTC.
//  4. RLS تُضاف عبر SQL migration يدوية (Prisma لا تولّدها).
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------------
// الهوية والمؤسسات
// ------------------------------------------------------------

/// المستخدم. المصادقة تتم في Auth0 (ADR-010)؛ هذا الجدول هو
/// السجل المحلي المرتبط به عبر auth0UserId، ومصدر صلاحيات المنصة.
model User {
  id            String    @id @default(uuid()) @db.Uuid
  /// معرّف المستخدم في Auth0 (sub). ثابت ولا يتغير.
  auth0UserId   String    @unique @map("auth0_user_id")
  email         String    @unique
  emailVerified Boolean   @default(false) @map("email_verified")
  fullName      String?   @map("full_name")
  avatarUrl     String?   @map("avatar_url")
  locale        String    @default("ar")
  timeZone      String    @default("Asia/Muscat") @map("time_zone")
  lastLoginAt   DateTime? @map("last_login_at") @db.Timestamptz(6)
  /// حذف ناعم — يُستخدم فقط حيث توجد حاجة قانونية أو تشغيلية (§6.6).
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  memberships   OrganizationMembership[]
  auditLogs     AuditLog[]
  consents      UserConsent[]
  platformAdmin PlatformAdmin?

  @@index([email])
  @@map("users")
}

/// المؤسسة (Tenant). جذر عزل البيانات في المنصة.
model Organization {
  id            String  @id @default(uuid()) @db.Uuid
  /// معرّف نصي فريد يُستخدم في المسارات الإدارية.
  slug          String  @unique
  name          String
  nameEn        String? @map("name_en")
  logoUrl       String? @map("logo_url")
  /// نوع المؤسسة: personal لحساب فردي، business لمؤسسة حقيقية.
  kind          String  @default("personal")
  defaultLocale String  @default("ar") @map("default_locale")

  /// بيانات الفوترة. تُطبع على الفاتورة ويحملها التزام ضريبي، فتُخزَّن
  /// كما أدخلها العميل لا كما استُنتجت من ملفه الشخصي.
  billingName      String? @map("billing_name")
  billingEmail     String? @map("billing_email")
  billingVatNumber String? @map("billing_vat_number")
  billingAddress   String? @map("billing_address")
  billingCountry   String  @default("OM") @map("billing_country")

  /// تعليق الحساب (§9.5 من خارطة الطريق). عمودان لا عمود واحد:
  /// منع لوحة التحكم عقوبة تشغيلية، وحجب الصفحة العامة إزالة محتوى
  /// منشور مطبوع على ورق — قراران مختلفان لا يُتخذان معاً بالضرورة.
  suspendedAt           DateTime? @map("suspended_at") @db.Timestamptz(6)
  suspensionReason      String?   @map("suspension_reason")
  suspendedByUserId     String?   @map("suspended_by_user_id") @db.Uuid
  publicAccessBlockedAt DateTime? @map("public_access_blocked_at") @db.Timestamptz(6)

  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  memberships    OrganizationMembership[]
  auditLogs      AuditLog[]
  files          FileObject[]
  cards          Card[]
  contacts       Contact[]
  tags           Tag[]
  departments    Department[]
  branches       Branch[]
  invitations    Invitation[]
  brandKit       BrandKit?
  brandPolicies  BrandPolicy[]
  customDomains  CustomDomain[]
  subscription   Subscription?
  invoices       Invoice[]
  payments       Payment[]
  supportTickets SupportTicket[]

  nfcTags            NfcTag[]
  campaigns          Campaign[]
  signatureTemplates SignatureTemplate[]
  walletPasses       WalletPass[]

  @@map("organizations")
}

/// عضوية مستخدم في مؤسسة. الأدوار تُفرض من هنا، لا من Auth0 Token.
model OrganizationMembership {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  status         String    @default("active")
  invitedAt      DateTime? @map("invited_at") @db.Timestamptz(6)
  joinedAt       DateTime? @map("joined_at") @db.Timestamptz(6)
  /// تعطيل العضوية يجب أن يمنع الوصول فوراً (§12.2 من وثيقة المعمارية).
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz(6)

  /// موقع الموظف في الهيكل. عمودان منفصلان لأنهما محوران مستقلان:
  /// موظف في «المبيعات» **و**في «فرع صحار» معاً.
  departmentId String? @map("department_id") @db.Uuid
  branchId     String? @map("branch_id") @db.Uuid

  /// بيانات الموظف كما تعرفها المؤسسة — لا كما كتبها هو في بطاقته.
  /// المصدران يختلفان عمداً: البطاقة ملك صاحبها، والدليل ملك المؤسسة.
  jobTitle   String? @map("job_title")
  jobTitleEn String? @map("job_title_en")
  employeeNo String? @map("employee_no")

  /// الظهور في دليل الموظفين. الإخفاء قرار الموظف أو مسؤوله،
  /// ولا يعني إلغاء العضوية.
  directoryVisible Boolean @default(true) @map("directory_visible")

  /// مغادرة الموظف. منفصل عن revokedAt: المغادرة حدث موارد بشرية له
  /// تاريخ معلن، والإلغاء إجراء تقني قد يسبقه أو يتأخر عنه.
  offboardedAt DateTime? @map("offboarded_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  roles        MembershipRole[]
  scopes       MembershipScope[]
  department   Department?       @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  branch       Branch?           @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@unique([organizationId, userId])
  @@unique([organizationId, employeeNo])
  @@index([organizationId, status])
  @@index([organizationId, departmentId])
  @@index([organizationId, branchId])
  @@index([userId])
  @@map("organization_memberships")
}

/// الأدوار. الأدوار النظامية عامة (organizationId = null)،
/// ويمكن لاحقاً إضافة أدوار مخصصة لكل مؤسسة.
model Role {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String?  @map("organization_id") @db.Uuid
  key            String
  name           String
  nameEn         String?  @map("name_en")
  isSystem       Boolean  @default(false) @map("is_system")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  permissions     RolePermission[]
  membershipRoles MembershipRole[]
  scopes          MembershipScope[]
  invitations     Invitation[]

  @@unique([organizationId, key])
  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  /// صيغة الصلاحية: resource:action — مثل cards:publish
  key         String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model MembershipRole {
  membershipId String @map("membership_id") @db.Uuid
  roleId       String @map("role_id") @db.Uuid

  membership OrganizationMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  role       Role                   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([membershipId, roleId])
  @@map("membership_roles")
}

// ------------------------------------------------------------
// سجل التدقيق (§9.5)
// ------------------------------------------------------------

model AuditLog {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String?  @map("organization_id") @db.Uuid
  actorUserId    String?  @map("actor_user_id") @db.Uuid
  action         String
  resourceType   String   @map("resource_type")
  resourceId     String?  @map("resource_id")
  /// نتيجة العملية: success | denied | failed
  outcome        String   @default("success")
  requestId      String?  @map("request_id")
  ipAddress      String?  @map("ip_address")
  userAgent      String?  @map("user_agent")
  /// Metadata محدودة — يُمنع وضع أسرار أو بيانات شخصية غير لازمة.
  metadata       Json?
  occurredAt     DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  actor        User?         @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, occurredAt(sort: Desc)])
  @@index([actorUserId, occurredAt(sort: Desc)])
  @@map("audit_logs")
}

// ------------------------------------------------------------
// البطاقات والقوالب (§7)
// ------------------------------------------------------------

/// تعريف قالب. القوالب مشتركة بين كل المؤسسات (بلا organizationId)
/// حتى المرحلة 4 حيث تُضاف قوالب مؤسسية خاصة.
model Template {
  key           String   @id
  name          String
  nameEn        String?  @map("name_en")
  /// أحدث إصدار منشور. البطاقات تثبّت إصداراً بعينه عند النشر.
  latestVersion Int      @default(1) @map("latest_version")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  versions TemplateVersion[]

  @@map("templates")
}

/// إصدار قالب.
///
/// وثيقة المعمارية §4.4: يجب حفظ Version حتى لا تتغير البطاقات
/// المنشورة بصورة غير مقصودة عند تحديث القالب. الإصدارات **غير
/// قابلة للتعديل** بعد نشرها — التغيير يعني إصداراً جديداً.
model TemplateVersion {
  templateKey String   @map("template_key")
  version     Int
  /// تعريف القالب: التخطيط، الأقسام المتاحة، القيم الافتراضية.
  definition  Json
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  template Template @relation(fields: [templateKey], references: [key], onDelete: Cascade)

  @@id([templateKey, version])
  @@map("template_versions")
}

/// البطاقة الرقمية.
///
/// المحتوى النصي يعيش في card_localizations لا هنا: البطاقة الواحدة
/// تُنشر بالعربية والإنجليزية، ووضع الحقول هنا كان سيفرض عموداً لكل
/// حقل لكل لغة.
model Card {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  ownerUserId    String @map("owner_user_id") @db.Uuid

  /// الرابط العام. **ثابت لا يتغير بتحديث البطاقة** — وإلا بطل كل
  /// QR مطبوع وكل رابط شاركه صاحبه (§7.4).
  slug   String
  /// draft | published | unpublished
  status String @default("draft")

  templateKey     String @map("template_key")
  /// إصدار القالب المثبَّت. يُثبَّت عند النشر فلا يتغير عرض البطاقة
  /// المنشورة حين يُحدَّث القالب.
  templateVersion Int    @map("template_version")

  /// الألوان والخطوط ونصف القطر — يختلف حسب القالب فلا يصلح أعمدة.
  theme        Json?
  /// ترتيب الأقسام وإظهارها. مصفوفة مفاتيح أقسام.
  sectionOrder Json? @map("section_order")

  /// اللغة الافتراضية للعرض حين لا يحدد الزائر لغة.
  defaultLocale String @default("ar") @map("default_locale")

  /// إعداد نموذج «شارك بياناتك معي»: تفعيله والحقول المعروضة.
  ///
  /// عمود JSON لا جدول: الإعداد يُقرأ ويُكتب مع البطاقة دائماً، ويدخل
  /// اللقطة المنشورة كاملاً — فالصفحة العامة ترسم النموذج بلا استعلام.
  contactForm Json? @map("contact_form")

  avatarFileId String? @map("avatar_file_id") @db.Uuid
  coverFileId  String? @map("cover_file_id") @db.Uuid
  logoFileId   String? @map("logo_file_id") @db.Uuid

  /// يمنع الكتابة فوق تعديل متزامن (§4.5 Optimistic Concurrency).
  revision Int @default(1)

  publishedAt DateTime? @map("published_at") @db.Timestamptz(6)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  localizations  CardLocalization[]
  links          CardLink[]
  publications   CardPublication[]
  contacts       Contact[]
  changeRequests CardChangeRequest[]

  nfcTags          NfcTag[]
  campaigns        Campaign[]
  walletPasses     WalletPass[]
  signatureProfile SignatureProfile?

  /// الـslug فريد عالمياً: يظهر في الرابط العام nomiqa.om/<slug>.
  @@unique([slug])
  @@index([organizationId, status])
  @@index([ownerUserId])
  @@map("cards")
}

/// محتوى البطاقة بلغة واحدة.
model CardLocalization {
  cardId String @map("card_id") @db.Uuid
  locale String

  fullName         String  @map("full_name")
  jobTitle         String? @map("job_title")
  organizationName String? @map("organization_name")
  department       String?
  bio              String?
  addressLine      String? @map("address_line")

  card Card @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@id([cardId, locale])
  @@map("card_localizations")
}

/// رابط أو وسيلة تواصل على البطاقة.
///
/// جدول واحد لكل الأنواع بدل عمود لكل وسيلة: إضافة وسيلة جديدة
/// تصبح صفاً لا مهاجرة، والترتيب والإظهار يصيران خاصية للصف.
model CardLink {
  id     String @id @default(uuid()) @db.Uuid
  cardId String @map("card_id") @db.Uuid

  /// phone | email | whatsapp | website | booking | social | custom
  type     String
  /// للشبكات الاجتماعية: linkedin | x | instagram …
  platform String?
  /// نص الزر. قد يختلف حسب اللغة، فيُحفظ لكل لغة عند الحاجة.
  label    String?
  labelEn  String? @map("label_en")
  /// القيمة الخام: رقم بصيغة E.164، بريد، أو رابط.
  value    String

  position  Int     @default(0)
  isVisible Boolean @default(true) @map("is_visible")
  /// زر إجراء رئيسي يظهر بارزاً (§7.2 Call to Action).
  isPrimary Boolean @default(false) @map("is_primary")

  card Card @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@index([cardId, position])
  @@map("card_links")
}

/// سجل عمليات النشر.
///
/// يحفظ **لقطة كاملة** من البطاقة وقت النشر. الغرض ليس التاريخ فحسب:
/// الصفحة العامة تُقدَّم من اللقطة لا من الجداول الحيّة، فلا يظهر
/// تعديل نصف مكتمل لزائر بينما صاحبها يحرر مسودته.
model CardPublication {
  id              String   @id @default(uuid()) @db.Uuid
  cardId          String   @map("card_id") @db.Uuid
  revision        Int
  templateKey     String   @map("template_key")
  templateVersion Int      @map("template_version")
  /// اللقطة المعروضة: المحتوى بكل اللغات والروابط والثيم.
  snapshot        Json
  publishedBy     String?  @map("published_by") @db.Uuid
  publishedAt     DateTime @default(now()) @map("published_at") @db.Timestamptz(6)

  card Card @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@index([cardId, publishedAt(sort: Desc)])
  @@map("card_publications")
}

// ------------------------------------------------------------
// جهات الاتصال (§8.2 و§8.3 من خارطة الطريق)
// ------------------------------------------------------------

/// جهة اتصال التقطها نموذج «شارك بياناتك معي» أو أُدخلت يدوياً.
///
/// **بيانات شخصية لطرف ثالث لم يسجّل في المنصة.** ولذلك:
///  - لا تُحفظ إلا بموافقة مسجَّلة في contact_consents داخل نفس الـTransaction.
///  - لا يظهر أي حقل منها في السجلات ولا في Metadata سجل التدقيق.
///  - الحذف ناعم كي يبقى أثر الموافقة والسحب قابلاً للإثبات.
model Contact {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  /// البطاقة التي التُقطت منها. تبقى null للإدخال اليدوي.
  cardId         String? @map("card_id") @db.Uuid

  fullName         String  @map("full_name")
  email            String?
  phone            String?
  organizationName String? @map("organization_name")
  jobTitle         String? @map("job_title")
  /// رسالة الزائر عند الإرسال — نصه هو، لا ملاحظة صاحب البطاقة.
  message          String?

  /// قيم الحقول الاختيارية التي عرّفها صاحب البطاقة: { key: value }.
  customFields Json? @map("custom_fields")

  /// card_form | manual | import
  source String @default("card_form")
  /// اللغة التي مُلئ بها النموذج — تحدد لغة رسالة الشكر.
  locale String @default("ar")

  /// new | in_progress | done | archived
  followUpStatus String    @default("new") @map("follow_up_status")
  /// تذكير خفيف على مستوى الصف. المهام المجدولة في follow_up_tasks.
  followUpAt     DateTime? @map("follow_up_at") @db.Timestamptz(6)

  /// مفاتيح مطبَّعة للمطابقة. مخزَّنة لا محسوبة عند الاستعلام: البحث
  /// عن تكرار يجب أن يستخدم فهرساً، ودالة على العمود تُبطل الفهرس.
  emailNormalized String? @map("email_normalized")
  phoneNormalized String? @map("phone_normalized")
  /// أول جهة اتصال تطابق هذه. **وسم لا دمج**: التقاط مكرر قد يكون
  /// لقاءً ثانياً حقيقياً، ودمجه آلياً يفقد سياق اللقاء الأول.
  duplicateOfId   String? @map("duplicate_of_id") @db.Uuid

  capturedAt DateTime  @default(now()) @map("captured_at") @db.Timestamptz(6)
  deletedAt  DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  card         Card?            @relation(fields: [cardId], references: [id], onDelete: SetNull)
  consents     ContactConsent[]
  notes        ContactNote[]
  tags         ContactTag[]
  followUps    FollowUpTask[]

  @@index([organizationId, capturedAt(sort: Desc)])
  @@index([organizationId, followUpStatus, capturedAt(sort: Desc)])
  @@index([organizationId, cardId, capturedAt(sort: Desc)])
  @@index([organizationId, emailNormalized])
  @@index([organizationId, phoneNormalized])
  @@map("contacts")
}

/// موافقة الزائر على حفظ بياناته.
///
/// جدول مستقل عن contacts لا عمود منطقي: الموافقة **حدث** له وقت ونص
/// وإصدار ومصدر، وسحبها لاحقاً صف جديد لا تعديل — فيبقى التاريخ كاملاً
/// وقابلاً للإثبات أمام جهة رقابية (نفس مبدأ user_consents §9.4).
model ContactConsent {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  contactId      String @map("contact_id") @db.Uuid

  /// contact_storage | marketing
  purpose            String
  granted            Boolean
  /// إصدار النص الذي وافق عليه الزائر — تغيّر النص يستوجب موافقة جديدة.
  consentTextVersion String   @map("consent_text_version")
  /// public_form | manual | import
  source             String   @default("public_form")
  /// للإثبات القانوني فقط ويخضع لسياسة الاحتفاظ.
  ipAddress          String?  @map("ip_address")
  userAgent          String?  @map("user_agent")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([contactId, purpose, createdAt(sort: Desc)])
  @@index([organizationId, createdAt(sort: Desc)])
  @@map("contact_consents")
}

/// ملاحظة صاحب البطاقة على جهة اتصال.
model ContactNote {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  contactId      String  @map("contact_id") @db.Uuid
  authorUserId   String? @map("author_user_id") @db.Uuid

  body      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([contactId, createdAt(sort: Desc)])
  @@map("contact_notes")
}

/// تصنيف يعرّفه المستخدم داخل مؤسسته.
model Tag {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  name  String
  /// لون العرض بصيغة ‎#RRGGBB. اختياري — الواجهة تشتق لوناً ثابتاً منه.
  color String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contacts     ContactTag[]

  /// الاسم فريد داخل المؤسسة لا عالمياً — التصنيفات ملك أصحابها.
  @@unique([organizationId, name])
  @@map("tags")
}

model ContactTag {
  contactId String @map("contact_id") @db.Uuid
  tagId     String @map("tag_id") @db.Uuid

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([contactId, tagId])
  @@index([tagId])
  @@map("contact_tags")
}

/// تذكير متابعة على جهة اتصال.
model FollowUpTask {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  contactId      String  @map("contact_id") @db.Uuid
  assignedUserId String? @map("assigned_user_id") @db.Uuid

  title  String
  dueAt  DateTime @map("due_at") @db.Timestamptz(6)
  /// open | done | cancelled
  status String   @default("open")

  completedAt DateTime? @map("completed_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([organizationId, status, dueAt])
  @@index([contactId, dueAt])
  @@map("follow_up_tasks")
}

// ------------------------------------------------------------
// التحليلات (§8.4 من خارطة الطريق)
// ------------------------------------------------------------

/// حدث خام على بطاقة عامة.
///
/// **لا يُخزَّن عنوان IP ولا User-Agent.** الزائر يُعرَّف بتجزئة يومية
/// لا رجعة فيها (`visitorHash`) تُحسب في الـAPI ولا تُخزَّن مكوناتها،
/// فلا يمكن ربط زيارات الشخص نفسه عبر الأيام ولا التعرف عليه.
/// قاعدة الاحتساب موثّقة في docs/analytics/definitions.md.
///
/// جدول عالي الحجم: يُكتب على دفعات من الـWorker لا صفاً صفاً، ولا
/// يحمل مفاتيح أجنبية إلى card_links — التحقق عند الكتابة يضاعف كلفة
/// كل صف مقابل قيد لا يحمي شيئاً في بيانات قياس.
model CardEvent {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  cardId         String @map("card_id") @db.Uuid

  /// view | link_click | vcard_download | qr_scan | form_view | form_submit
  type   String
  /// معرّف الرابط للنقرات. بلا مفتاح أجنبي — راجع تعليق النموذج.
  linkId String? @map("link_id") @db.Uuid

  /// تجزئة الزائر ليوم واحد. ليست معرّفاً دائماً ولا يمكن عكسها.
  visitorHash  String  @map("visitor_hash")
  /// لغة العرض وقت الحدث.
  locale       String?
  /// نطاق المُحيل فقط. المسار الكامل قد يحمل معرّفات في الاستعلام.
  referrerHost String? @map("referrer_host")
  /// mobile | tablet | desktop
  deviceType   String? @map("device_type")

  /// مصدر الزيارة (§10.4): direct | qr | nfc | campaign | signature | wallet | meeting.
  /// null لصفوف كُتبت قبل المرحلة 5 — تمييزها عن `direct` مقصود.
  source     String? @map("source")
  /// الحملة المُسنَد إليها. تُحلّ من الكود في دالة الإدراج لا في العميل.
  /// بلا مفتاح أجنبي، كبقية أعمدة هذا الجدول — راجع تعليق المهاجرة.
  campaignId String? @map("campaign_id") @db.Uuid

  occurredAt DateTime @map("occurred_at") @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([cardId, occurredAt(sort: Desc)])
  @@index([cardId, type, occurredAt(sort: Desc)])
  @@index([organizationId, occurredAt(sort: Desc)])
  @@index([occurredAt])
  @@index([campaignId, occurredAt(sort: Desc)])
  @@map("card_events")
}

/// تجميع مسبق للأحداث.
///
/// سببه أن لوحة المستخدم تُفتح كثيراً وتسأل عن أعداد شهر كامل؛ المسح
/// على الأحداث الخام في كل فتحة يجعل زمن اللوحة تابعاً لحجم المرور.
///
/// `dimension` عمود بُعد عام لا nullable: مفتاح أساسي يحوي عموداً
/// قابلاً لـnull لا يمنع التكرار في PostgreSQL. للنقرات يحمل معرّف
/// الرابط، ولغيرها سلسلة فارغة.
model AnalyticsRollup {
  organizationId String   @map("organization_id") @db.Uuid
  cardId         String   @map("card_id") @db.Uuid
  /// hour | day
  bucket         String
  bucketStart    DateTime @map("bucket_start") @db.Timestamptz(6)
  /// نفس أسماء أنواع الأحداث، مضافاً إليها unique_visitor.
  metric         String
  dimension      String   @default("")
  count          Int
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@id([cardId, bucket, bucketStart, metric, dimension])
  @@index([organizationId, bucket, bucketStart])
  @@index([cardId, bucket, metric, bucketStart])
  @@map("analytics_rollups")
}

// ------------------------------------------------------------
// إدارة المنصة (§6.4)
// ------------------------------------------------------------

/// صلاحية إدارة المنصة.
///
/// **ليست دوراً داخل مؤسسة.** أدوار المؤسسات تُمنح من داخل المنتج،
/// أما هذه فتُمنح خارج التطبيق عبر سكربت مقصود — لأنها تتجاوز حدود
/// المؤسسات، ولا يجوز أن تكون على بُعد نقرة في واجهة.
model PlatformAdmin {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @unique @map("user_id") @db.Uuid
  /// من منح الصلاحية. null للمنحة الأولى التي تُنشأ بالسكربت.
  grantedBy String?   @map("granted_by") @db.Uuid
  grantedAt DateTime  @default(now()) @map("granted_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("platform_admins")
}

/// سجل تدقيق عمليات المنصة.
///
/// منفصل عن audit_logs لأن ذاك مقيّد بالمؤسسة بحكم سياسة RLS،
/// وعمليات الإدارة تقع خارج أي مؤسسة.
model PlatformAuditLog {
  id           String   @id @default(uuid()) @db.Uuid
  actorUserId  String   @map("actor_user_id") @db.Uuid
  action       String
  resourceType String   @map("resource_type")
  resourceId   String?  @map("resource_id")
  metadata     Json?
  requestId    String?  @map("request_id")
  ipAddress    String?  @map("ip_address")
  occurredAt   DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)

  @@index([occurredAt(sort: Desc)])
  @@index([actorUserId, occurredAt(sort: Desc)])
  @@map("platform_audit_logs")
}

/// راية ميزة على مستوى المنصة (§6.4).
model FeatureFlag {
  key               String   @id
  description       String
  /// القيمة الافتراضية لكل المؤسسات.
  enabled           Boolean  @default(false)
  /// نسبة الإطلاق التدريجي 0–100، تُطبَّق حين enabled = false.
  rolloutPercentage Int      @default(0) @map("rollout_percentage")
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  overrides FeatureFlagOverride[]

  @@map("feature_flags")
}

/// استثناء صريح لمؤسسة بعينها. يتقدّم على الافتراضي وعلى النسبة.
model FeatureFlagOverride {
  flagKey        String   @map("flag_key")
  organizationId String   @map("organization_id") @db.Uuid
  enabled        Boolean
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  flag FeatureFlag @relation(fields: [flagKey], references: [key], onDelete: Cascade)

  @@id([flagKey, organizationId])
  @@index([organizationId])
  @@map("feature_flag_overrides")
}

// ------------------------------------------------------------
// الخصوصية والموافقات (§6.6 و§9.4)
// ------------------------------------------------------------

/// موافقة مستخدم على غرض معالجة محدد.
///
/// كل غرض موافقة مستقلة: الموافقة على شروط الخدمة ليست موافقة على
/// التسويق، ودمجهما مخالف لمتطلبات حماية البيانات الشخصية.
///
/// السجلات لا تُحدَّث بل تُضاف: سحب الموافقة صف جديد بـgranted=false،
/// فيبقى تاريخ الموافقات كاملاً وقابلاً للإثبات.
model UserConsent {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  /// terms | privacy | marketing
  purpose         String
  granted         Boolean
  /// إصدار النص الذي وافق عليه — تغيّر النص يستوجب موافقة جديدة.
  documentVersion String   @map("document_version")
  /// web | api | import
  source          String   @default("web")
  /// يُحفظ للإثبات القانوني فقط، ويخضع لسياسة الاحتفاظ.
  ipAddress       String?  @map("ip_address")
  userAgent       String?  @map("user_agent")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose, createdAt(sort: Desc)])
  @@map("user_consents")
}

/// طلب صاحب البيانات: تصدير أو حذف أو تصحيح.
///
/// لا مفتاح أجنبي إلى users عمداً: السجل يجب أن **يبقى بعد حذف
/// المستخدم** كإثبات تنفيذ الطلب. لذلك لا يحمل بيانات شخصية —
/// معرّف وتجزئة بريد فقط.
model DataSubjectRequest {
  id               String    @id @default(uuid()) @db.Uuid
  /// معرّف المستخدم وقت الطلب. يبقى بعد حذفه ولا يشير إلى صف قائم.
  subjectUserId    String    @map("subject_user_id") @db.Uuid
  /// تجزئة البريد — تكفي للربط عند الاستفسار دون تخزين العنوان.
  subjectEmailHash String    @map("subject_email_hash")
  /// export | deletion | rectification
  type             String
  /// pending | processing | completed | failed
  status           String    @default("pending")
  requestedAt      DateTime  @default(now()) @map("requested_at") @db.Timestamptz(6)
  completedAt      DateTime? @map("completed_at") @db.Timestamptz(6)
  failureReason    String?   @map("failure_reason")
  /// ملخص ما نُفِّذ: أعداد الصفوف والملفات المحذوفة، بلا محتوى.
  outcome          Json?

  @@index([subjectUserId, requestedAt(sort: Desc)])
  @@index([status, requestedAt])
  @@map("data_subject_requests")
}

// ------------------------------------------------------------
// الملفات (§8)
// ------------------------------------------------------------

/// سجل ملف في Object Storage. الملف الثنائي لا يُحفظ في PostgreSQL أبداً.
model FileObject {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  ownerUserId    String?   @map("owner_user_id") @db.Uuid
  /// مفتاح الكائن في التخزين — معرّف غير متوقع، لا اسم الملف الأصلي.
  storageKey     String    @unique @map("storage_key")
  /// الغرض: avatar | logo | cover | document
  purpose        String
  mimeType       String    @map("mime_type")
  sizeBytes      Int       @map("size_bytes")
  /// pending حتى يؤكَّد الرفع فعلياً بفحص وجود الكائن في التخزين.
  status         String    @default("pending")
  /// اسم الملف كما رفعه المستخدم — للعرض فقط، لا يُستخدم في المسار.
  originalName   String?   @map("original_name")
  uploadedAt     DateTime? @map("uploaded_at") @db.Timestamptz(6)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, purpose, createdAt(sort: Desc)])
  @@index([status, createdAt])
  @@map("file_objects")
}

// ------------------------------------------------------------
// الإشعارات (§5.9)
// ------------------------------------------------------------

/// سجل محاولات الإرسال. لا يخزّن محتوى الرسالة — البيانات الشخصية
/// تبقى خارج السجلات (§9.4)، ويُحفظ المرجع والحالة فقط.
model NotificationDelivery {
  id                String    @id @default(uuid()) @db.Uuid
  organizationId    String?   @map("organization_id") @db.Uuid
  /// email | in_app | push | sms
  channel           String
  /// مفتاح القالب، مثل welcome أو contact_captured
  template          String
  locale            String    @default("ar")
  /// تجزئة المستلم لا عنوانه — تكفي للربط دون تخزين بريد شخصي.
  recipientHash     String    @map("recipient_hash")
  /// pending | sent | failed
  status            String    @default("pending")
  attempts          Int       @default(0)
  lastError         String?   @map("last_error")
  /// معرّف الرسالة لدى المزوّد، لتتبّع الوصول لاحقاً.
  providerMessageId String?   @map("provider_message_id")
  sentAt            DateTime? @map("sent_at") @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([status, createdAt])
  @@map("notification_deliveries")
}

// ------------------------------------------------------------
// Transactional Outbox (§6.10)
// ------------------------------------------------------------

model OutboxEvent {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String?   @map("organization_id") @db.Uuid
  eventType      String    @map("event_type")
  payload        Json
  /// pending | processing | processed | failed
  status         String    @default("pending")
  attempts       Int       @default(0)
  lastError      String?   @map("last_error")
  availableAt    DateTime  @default(now()) @map("available_at") @db.Timestamptz(6)
  processedAt    DateTime? @map("processed_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([status, availableAt])
  @@map("outbox_events")
}

// ============================================================
// المرحلة الرابعة — الشركات والاشتراكات (خارطة الطريق §9)
// ============================================================

// ------------------------------------------------------------
// الهيكل التنظيمي (§9.2)
// ------------------------------------------------------------

/// إدارة أو قسم. شجرة: القسم قد يتبع إدارة أعلى.
model Department {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  /// الأب في الشجرة. null = إدارة عليا.
  parentId       String? @map("parent_id") @db.Uuid
  name           String
  nameEn         String? @map("name_en")
  /// رمز الإدارة في أنظمة المؤسسة — مفتاح المطابقة عند الاستيراد
  /// الجماعي، فملف الموارد البشرية يحمل رموزاً لا معرّفات UUID.
  code           String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parent       Department?              @relation("DepartmentTree", fields: [parentId], references: [id], onDelete: SetNull)
  children     Department[]             @relation("DepartmentTree")
  memberships  OrganizationMembership[]
  policies     BrandPolicy[]

  @@unique([organizationId, code])
  @@index([organizationId, parentId])
  @@map("departments")
}

/// فرع جغرافي.
model Branch {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  name           String
  nameEn         String? @map("name_en")
  code           String?
  city           String?
  country        String? @default("OM")
  addressLine    String? @map("address_line")
  phone          String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberships  OrganizationMembership[]
  policies     BrandPolicy[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("branches")
}

/// تفويض إداري بنطاق أضيق من المؤسسة — «مسؤول فرع أو إدارة».
///
/// جدول منفصل عن membership_roles عمداً: صفوف ذاك الجدول تمنح صلاحية
/// **على المؤسسة كلها**، وهو ما يقرؤه حارس الصلاحيات. خلط النطاقين في
/// جدول واحد كان يعني أن كل مسار قائم يقرأ الصلاحيات يبدأ فجأة بمنح
/// وصول شامل لمن فُوّض على إدارة واحدة. الفصل يُبقي Deny by default
/// صحيحاً بلا إعادة مراجعة كل مسار سابق.
model MembershipScope {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  membershipId   String @map("membership_id") @db.Uuid
  roleId         String @map("role_id") @db.Uuid
  /// department | branch
  scopeType      String @map("scope_type")
  scopeId        String @map("scope_id") @db.Uuid

  grantedByUserId String?  @map("granted_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  membership OrganizationMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  role       Role                   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([membershipId, roleId, scopeType, scopeId])
  @@index([organizationId, scopeType, scopeId])
  @@map("membership_scopes")
}

/// دعوة موظف.
///
/// الرمز يُخزَّن مجزّأً لا صريحاً: جدول الدعوات يُقرأ في كل عرض لقائمة
/// الفريق، وتسريب نسخة منه ما كان ليصبح تسريب مفاتيح انضمام صالحة.
model Invitation {
  id              String @id @default(uuid()) @db.Uuid
  organizationId  String @map("organization_id") @db.Uuid
  email           String
  /// البريد بعد التطبيع — مفتاح منع التكرار والمطابقة عند القبول.
  emailNormalized String @map("email_normalized")
  tokenHash       String @map("token_hash")

  roleId       String  @map("role_id") @db.Uuid
  departmentId String? @map("department_id") @db.Uuid
  branchId     String? @map("branch_id") @db.Uuid
  jobTitle     String? @map("job_title")
  employeeNo   String? @map("employee_no")
  locale       String  @default("ar")

  /// pending | accepted | revoked | expired
  status          String    @default("pending")
  invitedByUserId String?   @map("invited_by_user_id") @db.Uuid
  expiresAt       DateTime  @map("expires_at") @db.Timestamptz(6)
  acceptedAt      DateTime? @map("accepted_at") @db.Timestamptz(6)
  acceptedUserId  String?   @map("accepted_user_id") @db.Uuid
  revokedAt       DateTime? @map("revoked_at") @db.Timestamptz(6)
  /// دفعة الاستيراد التي أنشأت الدعوة — للتتبّع والإلغاء الجماعي.
  importId        String?   @map("import_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role         Role            @relation(fields: [roleId], references: [id], onDelete: Restrict)
  import       EmployeeImport? @relation(fields: [importId], references: [id], onDelete: SetNull)

  /// الرمز فريد عالمياً: القبول يجري قبل معرفة المؤسسة.
  @@unique([tokenHash])
  @@index([organizationId, status, createdAt(sort: Desc)])
  @@index([emailNormalized, status])
  @@map("invitations")
}

/// دفعة استيراد موظفين من CSV.
///
/// صف يمثّل الدفعة كلها لا سطراً منها: الاستيراد عملية طويلة تُنفَّذ في
/// الـWorker، والمسؤول يحتاج تقريراً واحداً يقرؤه لا مئة إشعار.
model EmployeeImport {
  id              String @id @default(uuid()) @db.Uuid
  organizationId  String @map("organization_id") @db.Uuid
  createdByUserId String @map("created_by_user_id") @db.Uuid
  fileName        String @map("file_name")

  /// pending | processing | completed | failed
  status      String  @default("pending")
  /// هل تُنشأ بطاقة مسودة لكل موظف مستورد؟
  createCards Boolean @default(false) @map("create_cards")
  /// هل تُرسل الدعوات فوراً أم تبقى معلّقة للمراجعة؟
  sendInvites Boolean @default(true) @map("send_invites")

  totalRows    Int @default(0) @map("total_rows")
  invitedCount Int @default(0) @map("invited_count")
  updatedCount Int @default(0) @map("updated_count")
  skippedCount Int @default(0) @map("skipped_count")
  errorCount   Int @default(0) @map("error_count")

  /// أخطاء الصفوف: رقم السطر والسبب. **لا يحمل قيم الحقول** — ملف
  /// الموارد البشرية بيانات شخصية، ونسخها في عمود يُقرأ في اللوحة
  /// يضاعف أماكن وجودها بلا داع.
  rowErrors Json? @map("row_errors")

  startedAt     DateTime? @map("started_at") @db.Timestamptz(6)
  finishedAt    DateTime? @map("finished_at") @db.Timestamptz(6)
  failureReason String?   @map("failure_reason")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  invitations Invitation[]

  @@index([organizationId, createdAt(sort: Desc)])
  @@map("employee_imports")
}

// ------------------------------------------------------------
// الهوية المؤسسية (§9.3)
// ------------------------------------------------------------

/// هوية المؤسسة البصرية. صف واحد لكل مؤسسة.
model BrandKit {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @unique @map("organization_id") @db.Uuid

  primaryColor    String? @map("primary_color")
  secondaryColor  String? @map("secondary_color")
  backgroundColor String? @map("background_color")
  textColor       String? @map("text_color")
  fontFamily      String? @map("font_family")

  logoFileId  String? @map("logo_file_id") @db.Uuid
  coverFileId String? @map("cover_file_id") @db.Uuid

  /// إخفاء شعار المنصة على الصفحة العامة — ميزة باقة لا تفضيل.
  /// القيمة هنا **نيّة** المؤسسة؛ التطبيق يشترط استحقاق الباقة أيضاً،
  /// فخفض الباقة يعيد الشعار بلا تعديل هذا الصف.
  hidePlatformBadge Boolean @default(false) @map("hide_platform_badge")

  updatedByUserId String?  @map("updated_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("brand_kits")
}

/// سياسة البطاقات: القالب المفروض، الحقول المقفلة، واشتراط الموافقة.
///
/// عدة صفوف لكل مؤسسة: صف عام (بلا إدارة ولا فرع) وصفوف أخص. الحل
/// يختار **الأخص المطابق** — إدارة، ثم فرع، ثم المؤسسة.
model BrandPolicy {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  departmentId   String? @map("department_id") @db.Uuid
  branchId       String? @map("branch_id") @db.Uuid

  name String

  /// القالب المفروض على بطاقات هذا النطاق. null = حر.
  templateKey String? @map("template_key")

  /// مفاتيح الحقول التي لا يعدّلها الموظف، مثل organizationName أو theme.
  lockedFields String[] @map("locked_fields")

  /// هل يمر تعديل البطاقة بسير موافقة قبل تطبيقه؟
  requireApproval Boolean @default(false) @map("require_approval")

  /// قيم تُفرض على كل بطاقة في النطاق (اسم المؤسسة، الألوان، الشعار).
  enforcedValues Json? @map("enforced_values")

  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  department   Department?  @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  branch       Branch?      @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@index([organizationId, isActive])
  @@map("brand_policies")
}

/// طلب تعديل بطاقة ينتظر موافقة.
///
/// الطلب يحمل **التعديل المقترح** لا البطاقة المعدَّلة: البطاقة نفسها
/// لا تُلمس حتى الموافقة، فلا توجد مسودة نصفها معتمد ونصفها لا.
model CardChangeRequest {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  cardId         String @map("card_id") @db.Uuid

  requestedByUserId String @map("requested_by_user_id") @db.Uuid
  /// pending | approved | rejected | withdrawn | stale
  status            String @default("pending")

  /// التعديل المقترح بصيغة مدخلات تحديث البطاقة.
  payload      Json
  /// إصدار البطاقة وقت تقديم الطلب. عدم تطابقه عند الموافقة يعني أن
  /// البطاقة تغيّرت بعد الطلب، فيُوسم الطلب stale ولا يُطبَّق أعمى.
  baseRevision Int  @map("base_revision")

  reviewedByUserId String?   @map("reviewed_by_user_id") @db.Uuid
  reviewedAt       DateTime? @map("reviewed_at") @db.Timestamptz(6)
  reviewNote       String?   @map("review_note")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  card Card @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@index([organizationId, status, createdAt(sort: Desc)])
  @@index([cardId, status])
  @@map("card_change_requests")
}

/// نطاق مخصص للمؤسسة.
///
/// الملكية تُثبَت بسجل TXT قبل التفعيل: بدونه يستطيع أي عميل أن يسجّل
/// نطاق غيره عندنا فيمنع صاحبه من استخدامه.
model CustomDomain {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  /// اسم المضيف بحروف صغيرة. فريد عالمياً — لا يخدم مضيفٌ مؤسستين.
  hostname       String @unique

  /// pending | verifying | active | failed | disabled
  status            String @default("pending")
  /// القيمة المطلوب وضعها في سجل TXT على _nomiqa-challenge.<hostname>
  verificationToken String @map("verification_token")

  verifiedAt    DateTime? @map("verified_at") @db.Timestamptz(6)
  lastCheckedAt DateTime? @map("last_checked_at") @db.Timestamptz(6)
  failureReason String?   @map("failure_reason")
  attempts      Int       @default(0)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
  @@index([status, lastCheckedAt])
  @@map("custom_domains")
}

// ------------------------------------------------------------
// الاشتراكات والفوترة (§9.4)
// ------------------------------------------------------------

/// باقة. صفوف لا ثوابت في الشيفرة: تعديل السعر أو الحد قرار تجاري
/// يتخذه مسؤول المنصة، ولا يجوز أن ينتظر إصداراً جديداً.
model Plan {
  id            String  @id @default(uuid()) @db.Uuid
  key           String  @unique
  name          String
  nameEn        String? @map("name_en")
  description   String?
  descriptionEn String? @map("description_en")

  /// الحدود العددية: maxCards, maxMembers, maxDepartments, maxBranches,
  /// maxContacts. القيمة ‎-1 تعني بلا حد.
  limits Json

  /// مفاتيح الميزات المتاحة — custom_domain، approval_workflow، إلخ.
  features String[]

  /// أيام التجربة المجانية عند أول اشتراك.
  trialDays Int @default(0) @map("trial_days")

  /// هل تظهر في صفحة الأسعار؟ باقة المؤسسات تُباع بالتفاوض وحده.
  isPublic  Boolean @default(true) @map("is_public")
  isActive  Boolean @default(true) @map("is_active")
  sortOrder Int     @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  prices        PlanPrice[]
  subscriptions Subscription[]

  @@map("plans")
}

/// سعر باقة لدورة فوترة وعملة.
///
/// المبلغ **بالبيسة** عدداً صحيحاً لا عشرياً: حساب ضريبة وخصم على أعداد
/// عشرية عائمة يُنتج فروق كسور تظهر في مستند يقرؤه محاسب.
model PlanPrice {
  id          String  @id @default(uuid()) @db.Uuid
  planId      String  @map("plan_id") @db.Uuid
  /// month | year
  interval    String
  currency    String  @default("OMR")
  amountBaisa Int     @map("amount_baisa")
  isActive    Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  plan          Plan           @relation(fields: [planId], references: [id], onDelete: Cascade)
  subscriptions Subscription[]

  @@unique([planId, interval, currency])
  @@map("plan_prices")
}

/// اشتراك المؤسسة. صف واحد لكل مؤسسة على الأكثر.
///
/// الترقية والخفض يعدّلان هذا الصف ولا ينشئان صفاً ثانياً: تاريخ
/// التغييرات يُحفظ في subscription_events، ووجود اشتراكين نشطين
/// لمؤسسة واحدة حالة لا معنى تجارياً لها ولا نريد شيفرة تتعامل معها.
model Subscription {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @unique @map("organization_id") @db.Uuid
  planId         String  @map("plan_id") @db.Uuid
  priceId        String? @map("price_id") @db.Uuid

  /// trialing | active | past_due | canceled | expired | pending
  status   String @default("pending")
  /// عدد المقاعد المدفوعة — التسعير حسب المستخدمين النشطين (§9.4).
  quantity Int    @default(1)

  currentPeriodStart DateTime  @map("current_period_start") @db.Timestamptz(6)
  currentPeriodEnd   DateTime  @map("current_period_end") @db.Timestamptz(6)
  trialEndsAt        DateTime? @map("trial_ends_at") @db.Timestamptz(6)

  /// الإلغاء لا يقطع الخدمة فوراً — الفترة المدفوعة حقّ مكتسب.
  cancelAtPeriodEnd Boolean   @default(false) @map("cancel_at_period_end")
  canceledAt        DateTime? @map("canceled_at") @db.Timestamptz(6)
  /// نهاية مهلة السماح بعد فشل التحصيل، قبل الخفض إلى المجانية.
  gracePeriodEndsAt DateTime? @map("grace_period_ends_at") @db.Timestamptz(6)

  couponId String? @map("coupon_id") @db.Uuid

  /// رمز العميل لدى المزوّد — للتحصيل المتكرر ببطاقة محفوظة.
  providerCustomerId String? @map("provider_customer_id")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan         Plan                @relation(fields: [planId], references: [id], onDelete: Restrict)
  price        PlanPrice?          @relation(fields: [priceId], references: [id], onDelete: SetNull)
  coupon       Coupon?             @relation(fields: [couponId], references: [id], onDelete: SetNull)
  events       SubscriptionEvent[]
  invoices     Invoice[]

  @@index([status, currentPeriodEnd])
  @@map("subscriptions")
}

/// حدث في دورة حياة الاشتراك — للتدقيق ولتقارير الإيراد.
model SubscriptionEvent {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  subscriptionId String   @map("subscription_id") @db.Uuid
  /// created | trial_started | activated | renewed | upgraded | downgraded
  /// | canceled | reactivated | payment_failed | expired
  type           String
  fromPlanId     String?  @map("from_plan_id") @db.Uuid
  toPlanId       String?  @map("to_plan_id") @db.Uuid
  actorUserId    String?  @map("actor_user_id") @db.Uuid
  metadata       Json?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([type, createdAt(sort: Desc)])
  @@map("subscription_events")
}

/// فاتورة.
///
/// كل المبالغ بالبيسة. الفاتورة **لا تُعدَّل بعد الإصدار** — التصحيح
/// إبطال وإصدار جديد، لأن المستند التزام ضريبي بيد العميل.
model Invoice {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  subscriptionId String? @map("subscription_id") @db.Uuid

  /// رقم الفاتورة المعروض. فريد عالمياً ومتسلسل — يُطلب في التدقيق.
  number String @unique

  /// draft | open | paid | void | uncollectible
  status String @default("draft")

  currency        String @default("OMR")
  subtotalBaisa   Int    @map("subtotal_baisa")
  discountBaisa   Int    @default(0) @map("discount_baisa")
  /// نسبة الضريبة وقت الإصدار بالنقاط الأساسية (5% = 500). تُخزَّن على
  /// الفاتورة ولا تُقرأ من الإعداد: تغيير النسبة لاحقاً لا يجوز أن
  /// يعيد حساب فاتورة صادرة.
  vatRateBps      Int    @default(500) @map("vat_rate_bps")
  vatBaisa        Int    @default(0) @map("vat_baisa")
  totalBaisa      Int    @map("total_baisa")
  amountPaidBaisa Int    @default(0) @map("amount_paid_baisa")

  periodStart DateTime? @map("period_start") @db.Timestamptz(6)
  periodEnd   DateTime? @map("period_end") @db.Timestamptz(6)
  issuedAt    DateTime? @map("issued_at") @db.Timestamptz(6)
  dueAt       DateTime? @map("due_at") @db.Timestamptz(6)
  paidAt      DateTime? @map("paid_at") @db.Timestamptz(6)
  voidedAt    DateTime? @map("voided_at") @db.Timestamptz(6)

  /// لقطة بيانات المشتري وقت الإصدار — تغيير عنوان المؤسسة لاحقاً
  /// لا يجوز أن يغيّر فاتورة سابقة.
  billingName      String? @map("billing_name")
  billingEmail     String? @map("billing_email")
  billingVatNumber String? @map("billing_vat_number")
  billingAddress   String? @map("billing_address")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  lines        InvoiceLine[]
  payments     Payment[]

  @@index([organizationId, issuedAt(sort: Desc)])
  @@index([status, dueAt])
  @@map("invoices")
}

model InvoiceLine {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  invoiceId      String @map("invoice_id") @db.Uuid

  description     String
  descriptionEn   String? @map("description_en")
  quantity        Int     @default(1)
  unitAmountBaisa Int     @map("unit_amount_baisa")
  amountBaisa     Int     @map("amount_baisa")
  metadata        Json?

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("invoice_lines")
}

/// محاولة دفع لدى مزوّد.
///
/// clientReferenceId فريد ويُولَّد عندنا: هو ما يربط جلسة المزوّد
/// بفاتورتنا، ويمنع احتساب دفعة مرتين إن تكرر النداء الراجع.
model Payment {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  invoiceId      String? @map("invoice_id") @db.Uuid

  /// thawani | manual
  provider String @default("thawani")
  /// pending | paid | failed | canceled | refunded
  status   String @default("pending")

  clientReferenceId String  @unique @map("client_reference_id")
  providerSessionId String? @map("provider_session_id")
  providerPaymentId String? @map("provider_payment_id")

  amountBaisa Int    @map("amount_baisa")
  currency    String @default("OMR")

  /// رابط صفحة الدفع. ينتهي بانتهاء الجلسة فلا يُعرض بعد اكتمالها.
  checkoutUrl   String?   @map("checkout_url")
  /// الحالة كما وردت من المزوّد نصاً — للتشخيص دون تفسير مسبق.
  rawStatus     String?   @map("raw_status")
  failureReason String?   @map("failure_reason")
  paidAt        DateTime? @map("paid_at") @db.Timestamptz(6)
  expiresAt     DateTime? @map("expires_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoice      Invoice?     @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([status, createdAt])
  @@index([providerSessionId])
  @@map("payments")
}

/// نداء راجع من المزوّد.
///
/// بلا organizationId ولا RLS: يصل قبل معرفة المؤسسة، ووظيفته الوحيدة
/// منع تكرار المعالجة. **لا يُوثَق بمحتواه** — استلامه إشارة فقط،
/// والحقيقة تُقرأ باستعلام الجلسة من المزوّد.
model PaymentEvent {
  id         String   @id @default(uuid()) @db.Uuid
  provider   String
  /// معرّف الحدث لدى المزوّد أو معرّف الجلسة — مفتاح منع التكرار.
  externalId String   @map("external_id")
  eventType  String   @map("event_type")
  paymentId  String?  @map("payment_id") @db.Uuid
  /// نتيجة المعالجة: received | applied | ignored | error
  outcome    String   @default("received")
  payload    Json?
  receivedAt DateTime @default(now()) @map("received_at") @db.Timestamptz(6)

  @@unique([provider, externalId, eventType])
  @@index([receivedAt(sort: Desc)])
  @@map("payment_events")
}

/// كود خصم.
model Coupon {
  id   String @id @default(uuid()) @db.Uuid
  code String @unique
  name String

  /// percent | fixed
  discountType  String  @map("discount_type")
  /// نسبة بالنقاط الأساسية إن كان percent، أو مبلغ بالبيسة إن كان fixed.
  discountValue Int     @map("discount_value")
  currency      String? @default("OMR")

  /// عدد دورات الفوترة التي يسري عليها الخصم. null = دائم.
  durationCycles Int? @map("duration_cycles")

  maxRedemptions    Int?     @map("max_redemptions")
  redeemedCount     Int      @default(0) @map("redeemed_count")
  /// مفاتيح الباقات التي يسري عليها. فارغة = كلها.
  appliesToPlanKeys String[] @map("applies_to_plan_keys")

  validFrom  DateTime  @default(now()) @map("valid_from") @db.Timestamptz(6)
  validUntil DateTime? @map("valid_until") @db.Timestamptz(6)
  isActive   Boolean   @default(true) @map("is_active")

  createdByUserId String?  @map("created_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  redemptions   CouponRedemption[]
  subscriptions Subscription[]

  @@map("coupons")
}

/// استخدام كود خصم. الفريد يمنع استخدام المؤسسة للكود مرتين.
model CouponRedemption {
  id             String   @id @default(uuid()) @db.Uuid
  couponId       String   @map("coupon_id") @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  invoiceId      String?  @map("invoice_id") @db.Uuid
  cyclesUsed     Int      @default(0) @map("cycles_used")
  redeemedAt     DateTime @default(now()) @map("redeemed_at") @db.Timestamptz(6)

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)

  @@unique([couponId, organizationId])
  @@index([organizationId])
  @@map("coupon_redemptions")
}

// ------------------------------------------------------------
// الدعم والبلاغات (§9.5)
// ------------------------------------------------------------

/// تذكرة دعم.
///
/// استثناء معلن من القاعدة «لوحة الإدارة لا تقرأ بيانات أي مؤسسة»:
/// المؤسسة تكتب هنا **قاصدةً** أن يقرأ فريق المنصة. لذلك لا يُنسخ في
/// التذكرة محتوى بطاقة ولا جهة اتصال — نص كتبه صاحب التذكرة فقط.
model SupportTicket {
  id              String @id @default(uuid()) @db.Uuid
  organizationId  String @map("organization_id") @db.Uuid
  createdByUserId String @map("created_by_user_id") @db.Uuid

  subject  String
  /// billing | technical | abuse | feature_request | other
  category String @default("other")
  /// low | normal | high | urgent
  priority String @default("normal")
  /// open | pending_customer | pending_platform | resolved | closed
  status   String @default("open")

  assignedAdminUserId String?   @map("assigned_admin_user_id") @db.Uuid
  firstResponseAt     DateTime? @map("first_response_at") @db.Timestamptz(6)
  resolvedAt          DateTime? @map("resolved_at") @db.Timestamptz(6)
  closedAt            DateTime? @map("closed_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  messages     SupportMessage[]

  @@index([organizationId, status, createdAt(sort: Desc)])
  @@index([status, priority, createdAt])
  @@map("support_tickets")
}

model SupportMessage {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  ticketId       String  @map("ticket_id") @db.Uuid
  authorUserId   String? @map("author_user_id") @db.Uuid
  /// customer | platform
  authorType     String  @map("author_type")
  body           String
  /// ملاحظة داخلية لا يراها العميل.
  isInternal     Boolean @default(false) @map("is_internal")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
  @@map("support_messages")
}

// ------------------------------------------------------------
// الحضور المهني المتكامل (§10)
// ------------------------------------------------------------

/// وسم NFC مرتبط ببطاقة.
///
/// **طبقة إحالة مقصودة بين المعدن والبطاقة.** الوسم يُكتب مرة واحدة
/// ولا يُكتب ثانية — قد يكون مقفلاً، وقد يكون في جيب موظف في بلد آخر.
/// لذلك يحمل كوداً خاصاً به لا رابط البطاقة مباشرةً: إعادة توجيهه إلى
/// بطاقة أخرى تصير صفاً يُحدَّث، وإبطال وسم مفقود يصير عموداً يُملأ،
/// وكلاهما مستحيل لو حمل الوسم الرابط النهائي.
model NfcTag {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  /// البطاقة الحالية. null لوسم أُصدر ولم يُسلَّم بعد.
  cardId         String? @map("card_id") @db.Uuid

  /// الكود في `nomiqa.om/t/<code>`. فريد عالمياً ويولّده الخادم.
  code   String
  /// اسم يميّزه للمسؤول: «وسم مكتب الاستقبال»، «بطاقة أحمد».
  label  String?
  /// unassigned | active | revoked
  status String  @default("unassigned")

  /// عدّاد تقريبي للاستخدام، يُحدَّث خارج مسار الطلب. ليس مقياساً
  /// تحليلياً — القياس الدقيق في card_events بمصدر nfc.
  scanCount  Int       @default(0) @map("scan_count")
  lastScanAt DateTime? @map("last_scan_at") @db.Timestamptz(6)

  revokedAt       DateTime? @map("revoked_at") @db.Timestamptz(6)
  revokedReason   String?   @map("revoked_reason")
  revokedByUserId String?   @map("revoked_by_user_id") @db.Uuid
  /// الوسم البديل الذي أُصدر عند الإبطال. يربط المفقود ببديله في السجل.
  replacedByTagId String?   @map("replaced_by_tag_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  card         Card?        @relation(fields: [cardId], references: [id], onDelete: SetNull)

  @@unique([code])
  @@index([organizationId, status])
  @@index([cardId])
  @@map("nfc_tags")
}

/// حملة تسويقية برمز مستقل (§10.4).
///
/// لماذا كود مستقل ولا يكفي UTM على رابط البطاقة: الحملة تُطبع على
/// لافتة معرض أو إعلان مطبوع، ورابط يحمل خمسة معاملات استعلام لا
/// يُقرأ ولا يُكتب يدوياً. الكود القصير يحمل المعاملات في الخادم
/// ويضيفها عند التوجيه، فيبقى المطبوع قصيراً والقياس كاملاً.
model Campaign {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  cardId         String @map("card_id") @db.Uuid

  code String
  name String

  utmSource   String  @map("utm_source")
  utmMedium   String  @map("utm_medium")
  utmCampaign String  @map("utm_campaign")
  utmTerm     String? @map("utm_term")
  utmContent  String? @map("utm_content")

  /// نافذة التشغيل. خارجها يظل الرابط يعمل ويصل إلى البطاقة، ولا
  /// يُسند إلى الحملة: زائر فتح لافتة معرض انتهى قبل شهر لا يجوز أن
  /// يُحسب في أرقامه، ولا يجوز أن يُقابَل بصفحة معطّلة.
  startsAt DateTime? @map("starts_at") @db.Timestamptz(6)
  endsAt   DateTime? @map("ends_at") @db.Timestamptz(6)
  isActive Boolean   @default(true) @map("is_active")

  createdByUserId String?  @map("created_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  card         Card         @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@unique([code])
  @@index([organizationId, isActive, createdAt(sort: Desc)])
  @@index([cardId])
  @@map("campaigns")
}

/// قالب توقيع مؤسسي مركزي (§10.5 خطوة 2).
model SignatureTemplate {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  name        String
  /// classic | compact | stacked | banner
  templateKey String @map("template_key")
  /// خيارات العرض: QR، الصورة، الشعار، اللون، إخلاء المسؤولية.
  options     Json

  isDefault  Boolean @default(false) @map("is_default")
  /// يقفل اختيار الموظف. التوقيع أكثر ما يظهر من هوية المؤسسة خارجها.
  isEnforced Boolean @default(false) @map("is_enforced")

  updatedByUserId String?  @map("updated_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, isDefault])
  @@map("signature_templates")
}

/// اختيار صاحب البطاقة لتوقيعه.
///
/// صف لكل بطاقة لا لكل مستخدم: من يملك بطاقتين — واحدة بالعربية
/// لعملاء محليين وأخرى بالإنجليزية — يحتاج توقيعاً لكل منهما.
model SignatureProfile {
  cardId         String @id @map("card_id") @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  templateKey String @map("template_key")
  options     Json

  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  card Card @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("signature_profiles")
}

/// بطاقة صادرة في محفظة رقمية (§10.2).
///
/// نحفظ الصادر لا لأن المحفظة تسألنا عنه، بل لأن **سحبه يحتاجه**:
/// موظف غادر المؤسسة تبقى بطاقته في هاتف كل من أضافها، ولا سبيل إلى
/// تحديثها أو إبطالها إلا برقمها التسلسلي ورمز مصادقتها.
model WalletPass {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  cardId         String @map("card_id") @db.Uuid

  /// apple | google
  platform     String
  serialNumber String @map("serial_number")

  /// رمز مصادقة خدمة تحديث Apple. عشوائي لكل بطاقة، ولا يُعاد عرضه
  /// بعد الإصدار — الجهاز وحده يحمله.
  authToken String? @map("auth_token")

  /// آخر إصدار أُنشئ. تحديث البطاقة يُنشئ إصداراً جديداً بالرقم نفسه.
  issuedAt  DateTime  @default(now()) @map("issued_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  card         Card         @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@unique([serialNumber])
  @@unique([cardId, platform])
  @@index([organizationId, platform])
  @@map("wallet_passes")
}
